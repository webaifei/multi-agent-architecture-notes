  "cards": [
    {
      "dot": "cyan",
      "title": "两处和直觉不一样",
      "items": [
        "session 不是链条上的一环，是横切面：turn/start、step/start、user/message、assistant/message、tool/result 每一步都 append",
        "工具结果不是直接回给模型的，而是 splice 回 inbox 的 next-step 队列，下一轮 preStep 再 claim 出来"
      ]
    },
    {
      "dot": "emerald",
      "title": "inbox 有两个队列",
      "items": [
        "next-turn：等到下一个 turn 才处理，用来排队新输入",
        "next-step：当前 step 结束后立刻插入，用来插话（steering）和回填工具上下文",
        "第一个 step 取 next-turn，之后 target 切成 next-step"
      ]
    },
    {
      "dot": "rose",
      "title": "一个 step 是什么",
      "items": [
        "一个 step = 一次模型请求 + 它要求的那些工具执行",
        "工具执行完回到 step 循环顶部，再 claim 一次 inbox，形成回环",
        "preStep 里留了 agent/pre-step waterfall，插件可以在发请求之前改写甚至拒绝"
      ]
    }
  ]
