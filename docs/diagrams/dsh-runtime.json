  "cards": [
    {
      "dot": "cyan",
      "title": "最外层循环",
      "items": [
        "kick() 里就是 while (await this.turn()) {}，turn 返回 true 表示队列还有活",
        "闲着的时候驱动器是 idle 的，靠 wakeDriver 唤醒，不是常驻轮询",
        "turn 的退出条件是「本轮跑完 且 next-step 队列为空」"
      ]
    },
    {
      "dot": "emerald",
      "title": "inbox 有两个队列",
      "items": [
        "next-turn 等到下一个 turn；next-step 在当前 step 结束后立刻插入",
        "第一个 step 取 next-turn，之后 target 切成 next-step",
        "队列状态是从 agent/inbox/spliced 事件折叠出来的，排队中的输入也进日志"
      ]
    },
    {
      "dot": "rose",
      "title": "工具结果的回程",
      "items": [
        "executeToolCalls 的最后一个参数是 acceptContext，把上下文消息 splice 回 next-step",
        "工具结果本身落成 tool/result，和用户插话走同一条队列",
        "工具按 executionMode 分组：parallel 才并发，上限 maxParallelToolCalls 默认 10"
      ]
    }
  ]
