  "cards": [
    {
      "dot": "cyan",
      "title": "外层循环与任务分层",
      "items": [
        "RegularTask::run 里 loop { run_turn(..) }，队列没活就收工",
        "turn 不只一种：Regular / Compact / Review / UserShell，各走各的驱动",
        "run_turn 的开场是压缩、记录输入、按输入拉起 MCP"
      ]
    },
    {
      "dot": "emerald",
      "title": "回合内继续的条件",
      "items": [
        "needs_follow_up = model_needs_follow_up || has_pending_input",
        "每一圈采样前先 get_pending_input，把插话记成 SteeredUserInput",
        "压缩写在 run_turn 开头，所以每个提前返回点都要补一次输入落盘"
      ]
    },
    {
      "dot": "rose",
      "title": "工具与安全",
      "items": [
        "工具走 ToolCallRuntime，命令审批和补丁审批是两个入口",
        "沙箱 read-only / workspace-write / danger-full-access 由 OS 强制",
        "会话落成 rollout JSONL，codex resume 靠它重建历史"
      ]
    }
  ]
